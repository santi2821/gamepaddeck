{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GamepadDeck",
  "version": "0.1.0",
  "identifier": "com.gamepaddeck.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GamepadDeck - PC Gamepad Engine & Server",
        "width": 1150,
        "height": 750,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
